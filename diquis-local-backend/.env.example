# Base de Datos (PostgreSQL Local)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_contraseña_aqui
POSTGRES_HOST=127.0.0.1  # Usa la IP de Windows (ej. 172.17.224.1) si estás usando WSL2
POSTGRES_PORT=5432
POSTGRES_DB=diquis

# JWT y Seguridad (No críticas en local)
SECRET_KEY=diquis_local_dev_secret_key_2026_change_in_prod
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Entorno y Rutas
PROJECT_NAME="Diquis Local"
ENVIRONMENT="development"
API_V1_STR="/api/v1"
FRONTEND_URL="http://localhost:5173"

# ℹ️ NOTA: Recuperación de contraseñas y correos
# Esta versión on-premise no incluye credenciales de servicios de correo electrónico (ej. Resend, Sendgrid).
# El sistema está programado para soportar el flujo de "Olvidé mi contraseña", pero 
# al estar en modo local, el enlace de recuperación seguro simplemente se imprimirá
# en la consola (terminal) donde se está ejecutando este servidor de FastAPI.
